<% if (String(body).trim().toLowerCase().startsWith('<!doctype')) { %><%- body %><% } else { %><!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
let pageTitle = String(title || '');
for (let i = 0; i < 5; i++) {
  const decodedTitle = unescapeHtml(pageTitle);
  if (decodedTitle === pageTitle) break;
  pageTitle = decodedTitle;
}
%>
<% const themeCfg = locals.themeConfig || {}; %>
<title><%= pageTitle %></title>
<% if (locals.og && locals.og.description) { %><meta name="description" content="<%= locals.og.description %>"><% } %>
<link rel="stylesheet" href="/css/global.css?v=<%= locals.assetVersion('css/global.css') %>">
<link rel="stylesheet" href="/css/style-panel.css?v=<%= locals.assetVersion('css/style-panel.css') %>">
<% (themeCfg.extraCss || []).forEach(function (cssHref) { const hrefStr = String(cssHref || ''); if (!hrefStr) return; %>
<link rel="stylesheet" href="<%= hrefStr %>?v=<%= hrefStr.startsWith('/') ? locals.assetVersion(hrefStr.slice(1)) : '1' %>">
<% }) %>
<link id="theme-css" rel="stylesheet" href="/css/<%= themeCfg.defaultTheme || 'yotsuba-b' %>.css">
<script src="/js/csrf.js?v=<%= locals.assetVersion('js/csrf.js') %>"></script>
<script src="/js/dom.js?v=<%= locals.assetVersion('js/dom.js') %>"></script>
<script src="/js/alert.js?v=<%= locals.assetVersion('js/alert.js') %>"></script>
<script>window.boardDefaultTheme = <%- JSON.stringify(locals.boardDefaultTheme || '').replace(/</g, '\\u003c') %>;</script>
<script>window.siteDisabledTabs = <%- JSON.stringify(locals.siteDisabledTabs || { mascots: false, customThemes: false }).replace(/</g, '\\u003c') %>;</script>
<script>window.currentBoardUri = <%- JSON.stringify(locals.boardUri || '').replace(/</g, '\\u003c') %>;</script>
<script>window.koshiMascotConfig = <%- JSON.stringify(locals.getMascotConfig ? locals.getMascotConfig(locals.boardUri || '') : { mascots: [], defaultMascotId: '', sitewideDefault: '', boardDefault: '' }).replace(/</g, '\\u003c') %>;</script>
<% if (themeCfg.defaultTheme || themeCfg.newPostSound || (Array.isArray(themeCfg.themes) && themeCfg.themes.length) || locals.siteName) { %>
<script>window.siteThemeConfig = <%- JSON.stringify({ siteName: locals.siteName || '', defaultTheme: themeCfg.defaultTheme || 'yotsuba-b', defaultThemeLabel: themeCfg.defaultThemeLabel || 'Yotsuba B', newPostSound: themeCfg.newPostSound || '', themes: themeCfg.themes || [] }).replace(/</g, '\\u003c') %>;</script>
<% } %>
<% if (themeCfg.framedBrowsing && (themeCfg.framedBrowsing.logo || (Array.isArray(themeCfg.framedBrowsing.boardSections) && themeCfg.framedBrowsing.boardSections.length))) { %>
<script>window.framedBrowsingConfig = <%- JSON.stringify(themeCfg.framedBrowsing).replace(/</g, '\\u003c') %>;</script>
<% } %>
<script src="/js/themes.js?v=<%= locals.assetVersion('js/themes.js') %>"></script>
<% styles.forEach(function (s) { %>
<link rel="stylesheet" href="<%= s %>">
<% }) %>
<%- head %>
<%- include('partials/open-graph', { og: locals.og }) %>
</head>
<body<% if (locals.bodyClass) { %> class="<%= locals.bodyClass %>"<% } %>>
<%- include('partials/header') %>
<div class="container"><main class="content<%= mod ? ' mod-page' : '' %>">
<% if (mod && locals.user && showNav) { %><%- include('mod/partials/nav') %><% } %>
<%- body %>
</main></div>
<%- include('partials/footer', { boardFooter: boardFooter }) %>
<% if (mod || locals.modControls) { %><script src="/js/mod.js?v=<%= locals.assetVersion('js/mod.js') %>"></script><script src="/js/edit-post.js?v=<%= locals.assetVersion('js/edit-post.js') %>"></script><% } %>
<script src="/js/captcha.js?v=<%= locals.assetVersion('js/captcha.js') %>"></script>
<script src="/js/thumb.js?v=<%= locals.assetVersion('js/thumb.js') %>"></script>
<script src="/js/thread-watcher.js?v=<%= locals.assetVersion('js/thread-watcher.js') %>"></script>
<script src="/js/style-panel.js?v=<%= locals.assetVersion('js/style-panel.js') %>"></script>
<script>
window.reportCategories = <%- JSON.stringify(locals.reportCategories || []).replace(/</g, '\\u003c') %>;
window.deletedPostDisplay = '<%= locals.deletedPostDisplay %>';
window.fileNameMaxLength = <%- Number(locals.fileNameMaxLength) || 30 %>;
</script>
<% if (modUser) { %>
<script src="/js/mod-view-toggle.js?v=<%= locals.assetVersion('js/mod-view-toggle.js') %>"></script>
<% if (mod || locals.modViewEnabled !== false) { %>
<script>
window.modUser = true;
window.modIsGlobalMod = <%= Number(modUser.globalRole) <= 2 ? 'true' : 'false' %>;
window.modShowIp = <%= showIp ? 'true' : 'false' %>;
</script>
<% } %>
<% } %>
<script src="/js/post-menu.js?v=<%= locals.assetVersion('js/post-menu.js') %>"></script>
<script src="/js/poll-handler.js?v=<%= locals.assetVersion('js/poll-handler.js') %>"></script>
<script src="/js/agree.js?v=<%= locals.assetVersion('js/agree.js') %>"></script>
<%
const currentView = String(locals.viewName || '');
(themeCfg.extraScripts || []).forEach(function (item) {
  const entry = typeof item === 'string' ? { src: item } : item;
  if (!entry || !entry.src) return;
  if (Array.isArray(entry.pages) && entry.pages.length && !entry.pages.includes(currentView)) return;
  const srcStr = String(entry.src);
  const srcWithVer = srcStr.startsWith('/') ? srcStr + '?v=' + locals.assetVersion(srcStr.slice(1)) : srcStr;
%>
<script src="<%= srcWithVer %>"<% if (entry.defer) { %> defer<% } %>></script>
<% }); %>
</body>
</html>
<% } %>