<% boardFooter = true; %>
<% title = '/' + boardUri + '/ - ' + (thread.subject || titleText(thread.message)); %>
<% styles = ['/css/tegaki.css', 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/monokai-sublime.min.css']; %>
<noscript><style>.post-form-collapsible { display: block !important; } .post-form-toggle-wrap { display: none; }</style></noscript>
<%- include('partials/banner') %>
<hr class="above-post-form">
<% if (modView) { %>
<%- include('/mod/partials/thread-toolbar', { user, roleLabel, boardUri, thread }) %>
<% } %>
<% if (!modView) { %>
  <% if (thread.locked) { %>
  <div class="reply-form-container">
    <h3 style="margin-top: 0;text-align:center;">This thread is locked and you cannot reply.</h3>
  </div>
  <% } else { %>
  <div class="post-form-toggle-wrap">
    [<a href="#" class="post-form-toggle-link" data-form-target="reply-form-container-top">Post a Reply</a>]
  </div>
  <div class="reply-form-container post-form-collapsible" id="reply-form-container-top">
    <form action="/<%= boardUri %>/thread/<%= thread.threadId %>/reply" class="reply-form" id="reply-form" method="POST" enctype="multipart/form-data" data-max-files="<%= maxUploadFiles %>">
      <%- include('partials/post-form') %>
    </form>
    <noscript><a href="/styling">Styling</a></noscript>
  </div>
  <% } %>
<% } %>
<%- include('partials/announcement') %>
<% if (boardMessage) { %>
<hr>
<div style="text-align: center"><%- boardMessage %></div>
<% } %>
<hr>
<% if (!modView) { %>[<a href="#" id="gallery-btn">Gallery</a>] <% } %>[<a href="/<%= boardUri %>/">Return</a>] [<a href="/<%= boardUri %>/catalog">Catalog</a>] [<a href="#bottom">Bottom</a>]<% if (modUser) { const isModMode = Boolean(modView || locals.modViewEnabled !== false); %> <% if (!modView) { %>[<a href="/mod/thread/<%= boardUri %>/<%= thread.threadId %>">Moderate</a>] <% } %>[<a href="#" class="mod-view-toggle" data-target-mode="<%= isModMode ? 'regular' : 'mod' %>"<% if (modView) { %> data-regular-url="/<%= boardUri %>/thread/<%= thread.threadId %>"<% } %> title="Switch between mod view (IPs &amp; mod options) and regular user view"><%= isModMode ? 'Regular View' : 'Mod View' %></a>]<% } %>
<hr>
<div class="thread" id="<%= thread.threadId %>">
<%- include('cells/op', { thread, boardUri, isThread: true, modView, showIp, globalStaff }) %>
<div class="replies" id="replies">
  
  <% if (locals.omittedReplyCount) { %>
  <span class="summary omitted-notice" id="omitted-notice" data-board="<%= boardUri %>" data-thread-id="<%= thread.threadId %>" data-before="<%= locals.firstShownReplyId %>">
    <span class="omitted-posts"><a href="#" class="expand-omitted" title="Load the earlier replies"><%= locals.omittedReplyCount %> post<%= locals.omittedReplyCount === 1 ? '' : 's' %> and <%= locals.omittedImageCount %> image repl<%= locals.omittedImageCount === 1 ? 'y' : 'ies' %> omitted. Click to expand.</a></span>
    <span class="expanded-posts" style="display: none"><a href="#" class="collapse-omitted">Collapse the earlier replies</a></span>
  </span>
  <% } %>
  <% posts.forEach((post, index) => { %>
  <%- include('cells/reply', { reply: post, thread, boardUri, replyNumber: index + 1 + (locals.omittedReplyCount || 0), modView, showIp, globalStaff }) %>
  <% }) %>
</div>
</div>
<hr>
<div id="bottom">
<% if (!modView) { %>[<a href="#" id="gallery-btn">Gallery</a>] <% } %>[<a href="/<%= boardUri %>/">Return</a>] [<a href="/<%= boardUri %>/catalog">Catalog</a>] [<a href="#">Top</a>]
<span class="summary">There are <%= thread.totalReplies + 1 %> posts made by <%= thread.uniquePosters %> people with <%= thread.totalFiles %> files.</span>
</div>
<hr>
<% if (!modView) { %>
<span id="countdown" class="thread-refresh-controls">
  <input type="button" id="thread-refresh-btn" value="Refresh">
  <label><input type="checkbox" id="thread-auto-refresh" checked> Auto <span id="thread-refresh-label"></span></label>
</span>
<form id="delete-form" action="/api/delete-posts" method="POST" style="float: right;margin-top: 10px;margin-right: 10px;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  Delete post:
  [ <input type="checkbox" id="file-only" name="fileOnly" value="true"> File only ]
  <input type="password" id="delete-password" name="password" style="width: 50px;">
  <button type="submit">Delete</button>
</form>
<div style="clear: both"></div>
<% } %>
<hr>
<% if (!modView && !thread.locked && Array.isArray(locals.board?.settings) && locals.board.settings.includes('bottomReplyForm')) { %>
<div class="post-form-toggle-wrap">
  [<a href="#" class="post-form-toggle-link" data-form-target="reply-form-container-bottom">Post a Reply</a>]
</div>
<div class="reply-form-container post-form-collapsible" id="reply-form-container-bottom">
  <form action="/<%= boardUri %>/thread/<%= thread.threadId %>/reply" class="reply-form" id="reply-form-bottom" method="POST" enctype="multipart/form-data" data-max-files="<%= maxUploadFiles %>">
    <%- include('partials/post-form', { formSuffix: '-bottom' }) %>
  </form>
</div>
<hr>
<% } %>
<% if (modView) { %>
<%- include('/mod/partials/panels') %>
<% } %>
<% if (!modView) { %>
<%- include('partials/quick-reply') %>
<% } %>

<script src="/js/tegaki.min.js"></script>
<script src="/js/tegaki-replay.js"></script>
<script src="/js/thread.js?v=<%= locals.assetVersion('js/thread.js') %>"></script>
<script src="/js/quote.js?v=<%= locals.assetVersion('js/quote.js') %>"></script>
<script src="/js/post-inline.js?v=<%= locals.assetVersion('js/post-inline.js') %>"></script>
<script src="/js/delete-form.js?v=<%= locals.assetVersion('js/delete-form.js') %>"></script>
<script src="/js/upload.js?v=<%= locals.assetVersion('js/upload.js') %>"></script>
<script src="/js/expansion.js?v=<%= locals.assetVersion('js/expansion.js') %>"></script>
<script src="/js/omitted-replies.js?v=<%= locals.assetVersion('js/omitted-replies.js') %>"></script>
<script src="/js/gallery.js?v=<%= locals.assetVersion('js/gallery.js') %>"></script>
<script src="/js/you.js?v=<%= locals.assetVersion('js/you.js') %>"></script>
<% if (modView) { %>
<script>
  window.modBoardUri = '<%= boardUri %>';
  window.modThreadId = <%= thread.threadId %>;
</script>
<script src="/js/mod.js?v=<%= locals.assetVersion('js/mod.js') %>"></script>
<script src="/js/edit-post.js?v=<%= locals.assetVersion('js/edit-post.js') %>"></script>
<% } %>
