<% title = 'Warned!'; %>
<div class="box-layout">
  <div class="box-outer top-box" style="display: flow-root;">
    <div class="boxbar"><h2>You have been warned!</h2></div>
    <div class="boxcontent" style="display: flow-root;">
      <img src="/img/gtfo.webp" class="ban-image" width="400" alt="">
      You have been warned on <b><%= warning.boardUri === 'all boards' ? 'all boards' : '/' + warning.boardUri + '/' %></b> for the following reason:
      <br><br>
      <b><%= warning.reason %></b>
      <br><br>
      Now that you have viewed this warning, it has expired and you may continue posting.
      <br><br>
      This page will auto redirect in <span id="warn-redirect-seconds">10</span> seconds.
    </div>
  </div>
</div>
<script>
  (function () {
    var targetUrl = <%- JSON.stringify(returnUrl || '/').replace(/</g, '\\u003c') %>;
    var secondsLeft = 10;
    var countdownEl = document.getElementById('warn-redirect-seconds');
    var timer = setInterval(function () {
      secondsLeft -= 1;
      if (countdownEl && secondsLeft >= 0) {
        countdownEl.textContent = String(secondsLeft);
      }
      if (secondsLeft <= 0) {
        clearInterval(timer);
        window.location.href = targetUrl;
      }
    }, 1000);
  })();
</script>
