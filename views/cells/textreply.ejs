<%
var archivePrefix = locals.isArchive ? 'archive/' : '';
var href = '/' + boardUri + '/' + archivePrefix + 'thread/' + thread.threadId;
var threadHref = modView ? '/mod/thread/' + boardUri + '/' + thread.threadId : href;
var controls = modView || locals.modControls;
%>
<div class="reply<%= controls && reply.isTor ? ' mod-tor-post' : '' %>"
data-post-id="<%= reply.postId %>"
data-thread-id="<%= thread.threadId %>"
data-board="<%= boardUri %>"
<% if (controls && reply.isTor) { %>data-tor="1" data-tor-kind="<%= reply.torKind || 'exit' %>"<% } %>
<% if (locals.replyNumber != null) { %>data-reply-number="<%= replyNumber %>"<% } %>>
  <div class="post-info">
    <% if (locals.replyNumber != null) { %><span class="reply-number" title="Reply #<%= replyNumber %>"><%= replyNumber %></span> <% } %><% if (!modView) { %><span class="post-quote">&gt;&gt;</span> <% } %>
    <% if (!locals.isSearchResult) { %><input type="checkbox" class="<%= modView ? 'mod-select' : 'post-checkbox' %>" <% if (modView) { %>value="<%= boardUri %>-<%= thread.threadId %>-<%= reply.postId %>"<% } else { %>name="posts" form="delete-form" value="<%= reply.postId %>-false"<% } %>><% } %>
    Name:
    <% const cap = locals.capcodeFor(reply.signedRole); %>
    <% if (cap) { %>
      <span<% if (cap.title) { %> title="<%= cap.title %>"<% } %> class="<%= cap.className %> name" data-capcode="<%= cap.text %>"><% if (reply.sage) { %><a class="sage-name-link" href=" /sage" title="sage"><%- reply.name %></a><% } else { %><%- reply.name %><% } %><span class="capcode-label"> ## <%= cap.text %><% if (cap.icon) { %> <img src="<%= cap.icon %>"><% } %></span></span>
      <% } else { %>
        <span class="name" data-post-id="<%= reply.postId %>" data-board="<%= boardUri %>" data-thread-id="<%= thread.threadId %>"><% if (reply.sage) { %><a class="sage-name-link" href=" /sage" title="sage"><%- reply.name %></a><% } else { %><%- reply.name %><% } %></span>
      <%}%>
      <%- include('../partials/post-flag', { flag: reply.flag, flagName: reply.flagName }).trim() %>
      <%- include('../partials/time', { date: reply.creation }) %>
    <span class="post-num"><a class="linkQuote" title="Link to this post" href="<%= threadHref %>#<%= reply.postId %>">No.</a>
    <a class="linkQuote" title="Reply to this post" href="<%= href %>#q<%= reply.postId %>"><%= reply.postId %></a><%- include('agree-button', { postId: reply.postId, isThread: false, agreeCount: reply.agreeCount }) %></span>
    <% if (controls) { %>
    <%- include('/mod/partials/post-links', { boardUri, thread, postId: reply.postId, isThread: false, post: reply, showIp, globalStaff }) %>
    <% } %>
    <div class="backlinks"></div>
    <% if (controls) { %>
    <%- include('/mod/partials/staff-info', { post: reply, showIp }) %>
    <% } %>
  </div>
  <div class="reply-content"><%
    let parsedMSG = locals.expandMediaEmbeds(reply.markdown);
    const boardLinkRegex = /href=["'](?:[^"']*?\/)?([\w-]+)\/res\/(\d+)\.html(?:#(\d+))?["']/gi;
    parsedMSG = parsedMSG.replace(boardLinkRegex, (match, board, threadId, post) => {
      const archivePrefix = locals.isArchive ? 'archive/' : '';
      return `href="/${board}/${archivePrefix}thread/${threadId}${post ? '#'+post : ''}"`;
    });
    if (locals.isArchive) {
      parsedMSG = parsedMSG.replace(/href=["']\/([\w-]+)\/thread\/(\d+)(?:#(\d+))?["']/gi, (match, board, threadId, postId) => {
        return `href="/${board}/archive/thread/${threadId}${postId ? '#'+postId : ''}"`;
      });
    }
  %><%- parsedMSG %><% if (reply.warningMessage) { %>
    <%- include('../partials/warning-message', { message: reply.warningMessage }) %>
    <% } else if (reply.banMessage) { %>
      <div class="ban-message">
        <%- reply.banMessage %>
      </div>
    <% } %>
  </div>
</div>
