<% if (locals.captcha && (locals.captcha.required || locals.captcha.solved)) { %>
<% const captchaProvider = locals.captcha.provider || 'recaptcha'; %>
<div class="captcha<%= locals.captcha.solved ? ' captcha-verified' : '' %>" data-captcha data-provider="<%= captchaProvider %>" data-sitekey="<%= locals.captcha.siteKey || '' %>" data-board="<%= locals.boardUri || '' %>" data-verified="<%= locals.captcha.solved ? 1 : 0 %>">
  <p class="captcha-verified-line"><span class="captcha-tick" aria-hidden="true">&#10004;</span> Verified.</p>
  <p class="captcha-actions captcha-actions-open"><button type="button" class="captcha-open">Open Captcha</button></p>
  <div class="captcha-puzzle">
    <% if (captchaProvider === 'waptcha') { %>
    <p class="captcha-title">Name the character shown in the picture.</p>
    <img class="captcha-image"/>
    <p class="captcha-controls">
      <input type="text" class="input-text captcha-answer" autocomplete="off" spellcheck="false" placeholder="..." />
      <button type="button" class="captcha-check">Check</button>
      <button type="button" class="captcha-refresh">&#8635;</button>
    </p>
    <p class="captcha-message">Loading image&hellip;</p>
    <% } else { %>
    <div class="captcha-provider-widget"></div>
    <p class="captcha-message"></p>
    <% } %>
    <noscript><p class="captcha-message captcha-bad">The captcha needs JavaScript - without it you cannot post while it is on.</p></noscript>
  </div>
  <p class="captcha-actions captcha-actions-hide"><button type="button" class="captcha-hide">Close Captcha</button></p>
</div>
<% } %>
