<%
const footerCfg = (locals.themeConfig && locals.themeConfig.footer) || {};
const footerLinks = Array.isArray(footerCfg.links) && footerCfg.links.length
  ? footerCfg.links
  : [
      { href: '/faq', label: 'FAQ' },
      { href: '/rules', label: 'Rules' },
      { href: '/news', label: 'News' },
      { href: '/stats', label: 'Stats' }
    ];
const footerDisclaimer = typeof footerCfg.disclaimerHtml === 'string' && footerCfg.disclaimerHtml
  ? footerCfg.disclaimerHtml
  : 'The stories and information posted here are artistic works of fiction and falsehood.<br />Only a fool would take anything posted here as fact.';
const footerCreditLabel = footerCfg.creditLabel || 'koshi';
const footerCreditUrl = footerCfg.creditUrl || 'https://github.com/koshi-chan/koshi';
%>
<footer id="footer">
  <% if (boardFooter) { %>
    <nav class="board-list footer-board-list">
      <% if (footerCfg.showHomeAndAll) { %>[ <a href="/">home</a> ] <% } %>[
      <% if (navBoards.length) { navBoards.forEach(function(board, i) { %>
      <a href="/<%= board.boardUri %>/"><%= board.boardUri %></a><% if (i < navBoards.length - 1) { %> /<% } %>
      <% }); } %>
      ]<% if (footerCfg.showHomeAndAll) { %> [ <a href="/all">all</a> ]<% } %>
    </nav>
  <% } %>
    <div class="footer-nav-tools">
      [<a href="#" class="watch-list-btn">Thread Watcher</a>]
      <% if (boardFooter) { %>
      [<a href="#" class="settings-btn">Settings</a>]
      [<a href="#" class="style-btn">Style</a>]
      [<a href="/mod">Moderation</a>]<% if (locals.modUser) { const isModMode = Boolean(locals.modView || locals.modViewEnabled !== false); %> [<a href="#" class="mod-view-toggle" data-target-mode="<%= isModMode ? 'regular' : 'mod' %>"<% if (locals.modView && locals.boardUri) { %> data-regular-url="<%= locals.isThread && locals.threadId ? '/' + locals.boardUri + '/thread/' + locals.threadId : '/' + locals.boardUri + (locals.page && locals.page > 1 ? '/' + locals.page : '/') %>"<% } %> title="Switch between mod view (IPs &amp; mod options) and regular user view"><%= isModMode ? 'Regular View' : 'Mod View' %></a>]<% } %>
      <% } %>
    </div>
    <% if (boardFooter) { %>
      <div class="footer-text"><%- footerDisclaimer %></div>
    <% } %>
    <div id="footer-links">
      <% if (locals.torOnionHostname || locals.torKind === 'onion') { %>
      <div class="tor-footer-info">
        <% if (locals.torKind === 'onion') { %><span class="tor-badge">Connected via .onion</span> <% } %>
        <% if (locals.torOnionHostname) { %>Onion Service: <a href="http://<%= locals.torOnionHostname %>/"><code><%= locals.torOnionHostname %></code></a><% } %>
      </div>
      <% } %>
      <% footerLinks.forEach(function(item, i) { %><a href="<%= item.href %>"><%= item.label %></a><% if (i < footerLinks.length - 1) { %> • <% } %><% }); %><br>
      - <a href="<%= footerCreditUrl %>"><%= footerCreditLabel %></a><% if (locals.koshiVersion && koshiVersion.displayName) { %> <span class="koshi-version" title="<%= koshiVersion.fullDisplay || koshiVersion.displayName %>"><%= koshiVersion.displayName %></span><% } %> -
    </div>
</footer>
