<% const sfx = locals.formSuffix || ''; %>
<% if (!sfx) { %>
<script>
    function updateTextareaValueFromURL() {
        const hash = window.location.hash;
        if (hash && hash.startsWith('#q')) {
            const id = hash.substring(2);
            const topContainer = document.getElementById('reply-form-container-top');
            if (topContainer) {
                topContainer.classList.add('is-open');
                const wrap = topContainer.previousElementSibling;
                if (wrap && wrap.classList.contains('post-form-toggle-wrap')) wrap.style.display = 'none';
            }
            document.querySelectorAll('#post-form textarea[name="message"], .reply-form textarea[name="message"]').forEach(function(ta) {
                ta.value = `>>${id}\n`;
                ta.dispatchEvent(new Event('input', { bubbles: true }));
            });
        }
    }
    window.onload = updateTextareaValueFromURL;
    window.onhashchange = updateTextareaValueFromURL;

</script>
<% } %>

<style>
    .mode-select-group {
        font-size: 0.95em;
    }

    .mode-select-btn:hover {
        color: var(--hover-link-color);
    }

    .mode-select-btn {
        color: var(--link-color);
        cursor: pointer;
    }

</style>
    

<% const textBoard = locals.textBoard === true; %>
<% if (locals.isTor && locals.torPostingAllowed === false) { %>
<div class="tor-notice-banner">Posting via Tor is currently disabled on /<%= boardUri %>/.</div>
<% } %>
<table id="postformTable<%= sfx %>" class="postform-table">
    <tbody>
        <tr>
            <td class="post-block"><label for="name<%= sfx %>">Name</label></td>
            <td class="postform-input-cell">
                <input type="text" id="name<%= sfx %>" name="name" class="input-text" placeholder="<%= anonymousName %>" />
            </td>
        </tr>
        <% const formFlagMode = locals.flagModeFor ? locals.flagModeFor(locals.board) : 'off'; %>
        <% const formFlags = formFlagMode === 'custom' || formFlagMode === 'both' ? (locals.customFlagsFor ? locals.customFlagsFor(boardUri) : []) : []; %>
        <% if (formFlagMode === 'custom' || formFlagMode === 'both') { %>
        <tr>
            <td class="post-block"><label for="user_flag<%= sfx %>">Flag</label></td>
            <td class="postform-input-cell">
                <select id="user_flag<%= sfx %>" name="user_flag" class="input-text">
                    <option value=""><%= formFlagMode === 'both' ? 'None (use my country)' : 'None' %></option>
                    <% formFlags.forEach((flag) => { %><option value="<%= flag.name %>"><%= flag.label %></option><% }) %>
                </select>
            </td>
        </tr>
        <% } %>
        <tr>
            <td class="post-block"><label>Options</label></td>
            <td class="postform-input-cell">
                
                <details class="post-options" id="post-options<%= sfx %>">
                    <summary><select class="input-text post-options-select" tabindex="-1" aria-hidden="true"><option class="post-options-label">None</option></select></summary>
                    <div class="post-options-menu">
                        <label><input type="checkbox" id="fortune<%= sfx %>" name="fortune" value="true" /> Fortune</label>
                        <% if (isThread) { %>
                        <label><input type="checkbox" id="sage<%= sfx %>" name="sage" value="true" /> Sage</label>
                        <label><input type="checkbox" id="nonoko<%= sfx %>" name="nonoko" value="true" /> Nonoko</label>
                        <% } %>
                    </div>
                </details>
                <% if (isThread) { %>
                <button class="new-thread-btn" type="submit">New reply</button>
                <% } %>
            </td>
        </tr>
        <% if (!isThread) { %>
        <tr>
            <td class="post-block"><label for="subject<%= sfx %>">Subject</label></td>
            <td class="postform-input-cell subject-row-cell">
                <input type="text" id="subject<%= sfx %>" name="subject" class="input-text" />
                <button class="new-thread-btn" type="submit">New thread</button>
            </td>
        </tr>
        <% } %>
        <tr>
            <td class="post-block">
                <label for="message<%= sfx %>">Comment</label>
            </td>
            <td class="postform-input-cell">
                <textarea id="message<%= sfx %>" name="message" class="input-text" rows="5"></textarea>
                <p class="file-info no-js" style="margin: 0;font-size: 10px;">Max comment length: <span id="charCount<%= sfx %>">0</span>/4096</p>
                <% var youtubeOk = locals.youtubeAllowed !== false; %>
                <% var pollsOk = locals.pollsAllowed !== false; %>
                <% var tegakiOk = locals.tegakiAllowed !== false; %>
                <div class="js-only comment-block-extra">
                    <% if (pollsOk) { %>
                    <div id="poll-details<%= sfx %>" class="poll-details" style="display: <%= textBoard ? 'block' : 'none' %>; padding: 10px;">
                        <input type="text" autocomplete="off" name="poll_question" placeholder="Poll question" style="width: 98%; margin-bottom: 5px;" />
                        <div id="poll-options<%= sfx %>" data-max-options="<%= locals.maxPollOptions || 10 %>">
                            <input type="text" autocomplete="off" name="poll_options[]" placeholder="Option 1" style="width: 90%; margin-bottom: 5px;" />
                            <input type="text" autocomplete="off" name="poll_options[]" placeholder="Option 2" style="width: 90%; margin-bottom: 5px;" />
                        </div>
                        <button type="button" id="add-option<%= sfx %>" style="margin-bottom: 5px;">+ Add Option</button>
                        <div style="margin-top: 5px;">
                            <label>Poll duration:
                                <select name="poll_duration">
                                    <option value="1">1 day</option>
                                    <option value="3">3 days</option>
                                    <option value="7">1 week</option>
                                    <option value="30">1 month</option>
                                </select>
                            </label>
                        </div>
                    </div>
                    <% } %>
                    <% if (tegakiOk && !textBoard) { %>
                    <button type="button" id="tegaki-btn<%= sfx %>" title="Tegaki" class="form-button" style="display: none;">Tegaki</button>
                    <% } %>
                </div>
            </td>
        </tr>
        <% if (!textBoard && (youtubeOk || pollsOk || tegakiOk)) { %>
        <%
      var modeOptions = [{ mode: 'file', label: 'File' }];
      if (youtubeOk) modeOptions.push({ mode: 'youtube', label: 'Embed' });
      if (pollsOk) modeOptions.push({ mode: 'poll', label: 'Poll' });
      if (tegakiOk) modeOptions.push({ mode: 'tegaki', label: 'Tegaki' });
    %>
        <tr class="js-only">
            <td class="post-block"><label>Select</label></td>
            <td class="postform-input-cell">
                <span class="mode-select-group" role="group" aria-label="Attachment type">
                    <% modeOptions.forEach(function (opt, idx) { %>
                    <% if (idx > 0) { %> / <% } %>
                    <span class="mode-select-btn<%= idx === 0 ? ' active' : '' %>" data-mode="<%= opt.mode %>"><%= opt.label %></span>
                    <% }); %>
                </span>
            </td>
        </tr>
        <% } %>
        <% if (!textBoard) { %>
        <tr>
            <td class="post-block"><label id="file-row-label<%= sfx %>" for="standard-image<%= sfx %>">File</label></td>
            <td class="postform-input-cell">
                <div id="file-mode-content<%= sfx %>">
                    <div id="drop-zone<%= sfx %>" class="drop-zone">
                        Drag files here to upload or <br />click here to select them, or paste an image
                        <input type="file" id="image<%= sfx %>" name="image" accept="image/*,video/*,.jxl,.avif" style="display: none;" />
                    </div>
                    <div id="standard-file-input<%= sfx %>">
                        <input type="file" id="standard-image<%= sfx %>" name="image" accept="image/*,video/*,.jxl,.avif" />
                    </div>
                    <div id="preview-container<%= sfx %>" class="preview-container" style="margin-top: 10px; display: flex; gap: 10px; flex-wrap: wrap;"></div>
                </div>
                <% if (youtubeOk) { %>
                <div id="embed-mode-content<%= sfx %>" style="display: none;">
                    <input type="text" id="youtube-url<%= sfx %>" name="youtube-url" placeholder="Enter a supported URL here" style="width: 98%;" />
                </div>
                <% } %>
            </td>
        </tr>
        <% } %>
<% if (locals.captcha && (locals.captcha.required || locals.captcha.solved)) { %>
        <tr class="captcha-row">
            <td class="post-block"><label>Captcha</label></td>
            <td class="postform-input-cell"><%- include('captcha') %></td>
        </tr>
        <% } %>
        <tr>
            <td class="post-block"><label for="post-password<%= sfx %>">Password</label></td>
            <td class="postform-input-cell">
                <input type="text" id="post-password<%= sfx %>" name="post-password" class="input-text" autocomplete="off" spellcheck="false" value="<%= locals.formPassword %>" /><span id="delPasswordInfo<%= sfx %>"> (for deletion)</span>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="rules">
                <ul style="margin-left: 0; margin-top: 0; margin-bottom: 0;">
                    <li>Please read the <a href="/rules">Rules</a> and <a href="/faq">FAQ</a> before posting.</li>
                    <% if (!textBoard) { %>
                    <li>Supported file types are: GIF, JPG, OGG, MP3, MP4, PNG, SWF, WEBM, WEBP.</li>
                    <% } %>
                    <li>Supported embeds are: YouTube, Nicovideo, Twitter/X, Bluesky, BiliBili, Vocaroo.</li>
                    <% if (!textBoard) { %>
                    <li>Maximum file size allowed is 20MB.</li>
                    <li>Images greater than 250x250 pixels will be thumbnailed.</li>
                    <% } %>
                </ul>

            </td>
        </tr>
    </tbody>
</table>

<script>
    (function() {
        const sfx = <%- JSON.stringify(sfx) %>;
        const dropdown = document.getElementById('post-options' + sfx);
        if (dropdown) {
            const label = dropdown.querySelector('.post-options-label');
            const boxes = Array.from(dropdown.querySelectorAll('input[type="checkbox"]'));
            function updateLabel() {
                const ticked = boxes.filter(function(cb) { return cb.checked; }).map(function(cb) { return cb.parentNode.textContent.trim(); });
                label.textContent = ticked.length ? ticked.join(', ') : 'None';
            }
            document.addEventListener('change', function(e) {
                if (e.target instanceof HTMLInputElement && e.target.type === 'checkbox') updateLabel();
            });
            dropdown.closest('form')?.addEventListener('reset', function() { setTimeout(updateLabel); });
            document.addEventListener('click', function(e) {
                if (dropdown.open && !dropdown.contains(e.target)) dropdown.open = false;
            });
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && dropdown.open) dropdown.open = false;
            });
            updateLabel();
        }

        const msgEl = document.getElementById('message' + sfx);
        const countEl = document.getElementById('charCount' + sfx);
        if (msgEl && countEl) {
            msgEl.addEventListener('input', function() {
                countEl.textContent = this.value.length;
            });
        }
    })();

</script>

<% if (!sfx) { %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('#emo .emote').forEach(function(img) {
            img.style.cursor = 'pointer';
            img.addEventListener('click', function() {
                const message = document.getElementById('message');
                if (!message) return;
                const tag = ':' + img.title + ':';
                const start = message.selectionStart != null ? message.selectionStart : message.value.length;
                const end = message.selectionEnd != null ? message.selectionEnd : message.value.length;
                message.value = message.value.slice(0, start) + tag + message.value.slice(end);
                message.focus();
                message.selectionStart = message.selectionEnd = start + tag.length;
                message.dispatchEvent(new Event('input', { bubbles: true }));
            });
        });
    });

</script>
<% } %>

<% if (tegakiOk && !textBoard && !sfx) { %>
<script src="/js/tegaki-post.js"></script>
<% } %>

<% if (!textBoard && (youtubeOk || pollsOk || tegakiOk)) { %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const sfx = <%- JSON.stringify(sfx) %>;
        const root = document.getElementById('postformTable' + sfx) || document;
        const modeButtons = root.querySelectorAll('.mode-select-btn');
        const pollDetails = document.getElementById('poll-details' + sfx);
        const tegakiBtn = document.getElementById('tegaki-btn' + sfx);
        const fileModeContent = document.getElementById('file-mode-content' + sfx);
        const embedModeContent = document.getElementById('embed-mode-content' + sfx);
        const fileRowLabel = document.getElementById('file-row-label' + sfx);
        const fileInput = document.getElementById('image' + sfx);
        const youtubeUrl = document.getElementById('youtube-url' + sfx);

        function setMode(mode) {
            modeButtons.forEach(function(btn) {
                btn.classList.toggle('active', btn.dataset.mode === mode);
            });

            const isYoutube = mode === 'youtube';
            if (fileModeContent) fileModeContent.style.display = isYoutube ? 'none' : '';
            if (embedModeContent) embedModeContent.style.display = isYoutube ? 'block' : 'none';
            if (fileRowLabel) fileRowLabel.textContent = isYoutube ? 'Embed' : 'File';
            if (fileInput) fileInput.disabled = isYoutube;
            if (!isYoutube && youtubeUrl) youtubeUrl.value = '';

            if (pollDetails) pollDetails.style.display = mode === 'poll' ? 'block' : 'none';
        }

        modeButtons.forEach(function(btn) {
            btn.addEventListener('click', function() {
                const mode = btn.dataset.mode;

                if (mode === 'tegaki') {
                    if (tegakiBtn) tegakiBtn.click();
                    return;
                }

                setMode(mode);
            });
        });

        const standardFileInput = document.getElementById('standard-file-input' + sfx);
        if (standardFileInput) standardFileInput.style.display = 'none';
    });

</script>
<% } %>
<% if (!sfx) { %>
<script src="/js/post-password.js?v=<%= locals.assetVersion('js/post-password.js') %>" defer></script>
<% } %>
