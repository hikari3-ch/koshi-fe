<%
var created = new Date(date);
var delta = Math.round((created - Date.now()) / 60000);
var rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
var ago =
  Math.abs(delta) >= 1440 ? rtf.format(Math.round(delta / 1440), 'day') :
  Math.abs(delta) >= 60 ? rtf.format(Math.round(delta / 60), 'hour') :
  rtf.format(delta, 'minute');
%>
<span class="time-info" title="<%= ago %>"><%= created.toLocaleString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) %></span>
