<% title = 'Latest'; %>
<h1>Latest</h1>
<form method="get">
<% if (showIp) { %><input name="ip" placeholder="IP" value="<%= query.ip || '' %>"><% } %>
<input name="banId" placeholder="Ban ID" value="<%= query.banId || '' %>">
<input name="boardUri" placeholder="Board" value="<%= query.boardUri || '' %>">
<input name="threadId" placeholder="Thread" value="<%= query.threadId || '' %>">
<input name="postId" placeholder="Post" value="<%= query.postId || '' %>">
<button type="submit">Search</button>
</form>
<% results.forEach((r, i) => { %>
<div class="latest-entry">
<p>/<%= r.boardUri %>/</p>
<% if (r.isThread && r.thread.subject) { %><p><span class="subject"><%- r.thread.subject %></span></p><% } %>
<% if (r.isTextBoard) { %>
<%- include('../cells/textreply', { reply: r.reply, thread: r.thread, boardUri: r.boardUri, replyNumber: i + 1, modView: true, showIp, globalStaff }) %>
<% } else { %>
<%- include('../cells/reply', { reply: r.reply, thread: r.thread, boardUri: r.boardUri, replyNumber: i + 1, modView: true, showIp, globalStaff }) %>
<% } %>
</div>
<% }) %>
<p>
<% if (currentPage > 1) { %><a href="?<%= queryString %><%= queryString ? '&' : '' %>page=<%= currentPage - 1 %>">Prev</a><% } %>
<% if (currentPage > 1 && currentPage < totalPages) { %> / <% } %>
<% if (currentPage < totalPages) { %><a href="?<%= queryString %><%= queryString ? '&' : '' %>page=<%= currentPage + 1 %>">Next</a><% } %>
<% if (totalPages > 0) { %> / Page <%= currentPage %> of <%= totalPages %><% } %>
</p>
<%- include('/mod/partials/panels') %>
<script src="/js/quote.js"></script>
