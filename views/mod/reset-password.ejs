<% title = 'Reset Password'; %>
<div class="mod-login">
<h1>Reset Password</h1>
<% if (valid) { %>
<form id="reset-password-form">
<fieldset>
<legend>Set New Password for <%= login %></legend>
<table class="mod-settings">
<tr><th><label for="reset-new-password">New password</label></th><td><input type="password" id="reset-new-password" name="newPassword" required minlength="8" autocomplete="new-password"></td></tr>
<tr><th><label for="reset-confirm-password">Confirm password</label></th><td><input type="password" id="reset-confirm-password" name="confirmPassword" required minlength="8" autocomplete="new-password"></td></tr>
</table>
<input type="hidden" name="token" value="<%= token %>">
<div class="mod-actions">
  <button type="submit">Reset password</button>
  <a href="/mod/login">Cancel</a>
</div>
</fieldset>
</form>
<% } else { %>
<fieldset>
<legend>Invalid or Expired Link</legend>
<p class="mod-error"><%= error || 'This password reset link is invalid or has expired.' %></p>
<div class="mod-actions">
  <a href="/mod/forgot-password">Request a new reset link</a>
  <a href="/mod/login">Back to login</a>
</div>
</fieldset>
<% } %>
</div>
