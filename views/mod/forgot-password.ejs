<% title = 'Forgot Password'; %>
<div class="mod-login">
<h1>Password Reset</h1>
<% if (!locals.mailConfigured) { %>
<p class="mod-notice">Outgoing email is not configured on this server. Contact an administrator to reset your password.</p>
<% } %>
<form id="forgot-password-form">
<fieldset>
<legend>Request Reset Link</legend>
<table class="mod-settings">
<tr><th><label for="forgot-identifier">User / Email</label></th><td><input type="text" id="forgot-identifier" name="identifier" required maxlength="254" autocomplete="username"></td></tr>
</table>
<div class="mod-actions">
  <button type="submit">Send reset link</button>
  <a href="/mod/login">Back to login</a>
</div>
<p class="mod-hint" id="forgot-password-status" hidden></p>
</fieldset>
</form>
</div>
